---
// src/components/Header.astro
import contenido from '../data/contenido.json';
const { site } = contenido;

const whatsappUrl = site.whatsappLink; // canal de WhatsApp de BooxTV

const links = [
  { name: 'Contenido', href: '#contenido' },
  { name: 'Planes', href: '#planes' },
  { name: 'Dispositivos', href: '#dispositivos' },
  { name: 'Ayuda', href: '#faq' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <div class="mx-auto flex h-16 md:h-20 max-w-7xl items-center justify-between px-5 md:px-10">
    <a href="#inicio" class="flex items-center" aria-label={`${site.name}, inicio`}>
      <img src="/boox.svg" alt="" class="h-8 md:h-10 w-auto brightness-0 invert" />
    </a>

    <nav class="hidden md:flex items-center gap-9" aria-label="Principal">
      {links.map(link => (
        <a href={link.href} class="text-[15px] font-medium text-white/75 hover:text-white transition-colors">{link.name}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg bg-boox px-4 py-2 md:px-5 md:py-2.5 text-sm font-bold text-black hover:bg-yellow-400 transition-colors"
      >
        Prueba gratis
      </a>
      <button id="menu-btn" class="md:hidden -mr-2 p-2 text-white" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path id="menu-l1" stroke-linecap="round" d="M4 7h16" />
          <path id="menu-l2" stroke-linecap="round" d="M4 12h16" />
          <path id="menu-l3" stroke-linecap="round" d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-line bg-ink/98 backdrop-blur-xl">
    <nav class="flex flex-col px-5 py-4" aria-label="Menú móvil">
      {links.map(link => (
        <a href={link.href} class="mobile-link border-b border-line py-4 text-lg font-semibold text-white last:border-0">{link.name}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const initHeader = () => {
    const header = document.getElementById('site-header');
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!header || !btn || !menu) return;

    const paint = () => {
      const solid = window.scrollY > 24 || !menu.classList.contains('hidden');
      header.classList.toggle('bg-ink/95', solid);
      header.classList.toggle('backdrop-blur-xl', solid);
      header.classList.toggle('border-b', solid);
      header.classList.toggle('border-line', solid);
    };

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.getElementById('menu-l1')?.setAttribute('d', open ? 'M6 18L18 6' : 'M4 7h16');
      document.getElementById('menu-l2')?.setAttribute('opacity', open ? '0' : '1');
      document.getElementById('menu-l3')?.setAttribute('d', open ? 'M6 6l12 12' : 'M4 17h16');
      paint();
    };

    btn.onclick = () => setOpen(menu.classList.contains('hidden'));
    document.querySelectorAll('.mobile-link').forEach(l => ((l as HTMLElement).onclick = () => setOpen(false)));
    window.addEventListener('scroll', paint, { passive: true });
    paint();
  };

  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('astro:page-load', initHeader);
</script>
