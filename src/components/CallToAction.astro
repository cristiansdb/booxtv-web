---
// src/components/CallToAction.astro — cierre con invitación a la prueba
import contenido from '../data/contenido.json';
const { site } = contenido;
const trial = site.whatsappLink; // canal de WhatsApp de BooxTV
---

<section class="px-5 pb-20 md:px-10 md:pb-28">
  <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-gradient-to-br from-violet via-deep to-night px-6 py-14 text-center ring-1 ring-white/10 md:px-16 md:py-20">
    <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-boox/20 blur-[100px]" aria-hidden="true"></div>
    <h2 class="relative mx-auto max-w-3xl text-3xl md:text-5xl font-extrabold tracking-[-0.03em] leading-tight">Pruébalo hoy en tu televisión, sin pagar nada.</h2>
    <p class="relative mx-auto mt-5 max-w-xl text-lg text-white/75">Entra a nuestro canal de WhatsApp y pide tu prueba gratis. Te acompañamos para instalarla en tu equipo.</p>
    <div class="relative mt-9 flex flex-wrap justify-center gap-3">
      <a href={trial} target="_blank" rel="noopener noreferrer" class="rounded-full bg-boox px-8 py-4 font-bold text-black hover:bg-yellow-400 transition-colors">Pedir mi prueba gratis</a>
      <a href="#planes" class="rounded-full px-8 py-4 font-semibold ring-1 ring-white/30 hover:bg-white/10 transition-colors">Comparar planes</a>
    </div>
  </div>
</section>
