---
// src/components/AppDemo.astro
import booxVideo from "../assets/video.webm";
---

<section class="py-16 md:py-24 overflow-hidden">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-10 lg:grid-cols-[1.15fr_1fr]">
    <div>
      <h2 class="text-3xl md:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-tight">Llévalo contigo en el celular</h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-mist">
        Una app pensada para encontrar rápido lo que quieres ver: busca, guarda tus favoritos y descarga contenido para verlo sin conexión.
      </p>

      <dl class="mt-9 grid gap-6 sm:grid-cols-3">
        <div>
          <dt class="font-bold">Fácil de usar</dt>
          <dd class="mt-1 text-sm leading-relaxed text-mist">Menús claros y búsqueda en segundos.</dd>
        </div>
        <div>
          <dt class="font-bold">Reproducción rápida</dt>
          <dd class="mt-1 text-sm leading-relaxed text-mist">Canales y películas que cargan al instante.</dd>
        </div>
        <div>
          <dt class="font-bold">Favoritos y descargas</dt>
          <dd class="mt-1 text-sm leading-relaxed text-mist">Guarda lo que te gusta y míralo donde quieras.</dd>
        </div>
      </dl>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="https://apps.apple.com/mx/app/var-player-unlock-your-world/id6477530321" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-xl bg-white px-5 py-3 text-black hover:bg-white/85 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" class="h-6 w-6 fill-current" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
          <span class="text-left leading-tight"><span class="block text-[11px]">Descárgala en el</span><span class="block font-bold">App Store</span></span>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.rcmx.booads" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-xl bg-white/[0.06] px-5 py-3 text-white ring-1 ring-white/20 hover:bg-white/[0.12] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="h-6 w-6" aria-hidden="true"><path fill="#34A853" d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1z"/><path fill="#4285F4" d="M47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0z"/><path fill="#FBBC04" d="M472.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8z"/><path fill="#EA4335" d="M104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>
          <span class="text-left leading-tight"><span class="block text-[11px] text-mist">Disponible en</span><span class="block font-bold">Google Play</span></span>
        </a>
      </div>
    </div>

    <div class="relative flex justify-center">
      <div class="absolute inset-0 m-auto h-3/4 w-3/4 rounded-full bg-violet/60 blur-[90px]" aria-hidden="true"></div>
      <div class="relative w-[260px] sm:w-[300px] aspect-[9/19] overflow-hidden rounded-[2.75rem] border-[7px] border-[#1a1f35] bg-night shadow-[0_40px_90px_-30px_rgba(0,0,0,0.9)] ring-1 ring-white/15">
        <div class="absolute inset-x-0 top-0 z-10 mx-auto h-6 w-1/3 rounded-b-2xl bg-[#1a1f35]" aria-hidden="true"></div>
        <video src={booxVideo} class="h-full w-full object-cover" autoplay loop muted playsinline aria-label="Vista de la app de BooxTV en un celular"></video>
      </div>
    </div>
  </div>
</section>
