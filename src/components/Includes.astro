---
// src/components/Includes.astro — qué incluye cada plan
import contenido from '../data/contenido.json';
const { beneficios } = contenido;

// Íconos de línea propios en lugar de emojis (mismo orden que contenido.json → beneficios)
const icons = [
  '<path d="M3 6.5A1.5 1.5 0 014.5 5h15A1.5 1.5 0 0121 6.5v9a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 15.5v-9z"/><path d="M8 20h8M12 17v3"/>',
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v5M16 4v5"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M12 3a14 14 0 000 18M12 3a14 14 0 010 18M3.6 9h16.8M3.6 15h16.8"/>',
  '<rect x="2.5" y="6" width="19" height="13" rx="2"/><path d="M2.5 10h19M7 6l2.5 4M13 6l2.5 4"/>',
  '<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/>',
  '<path d="M4 13a8 8 0 1116 0v4a2 2 0 01-2 2h-1v-6h3M4 13v4a2 2 0 002 2h1v-6H4"/>',
];

const esOpcional = (t: string) => /opcional/i.test(t);
const titulo = (t: string) => {
  const limpio = t.replace(/\s*\(Opcional\)\s*/i, '').toLowerCase();
  return (limpio.charAt(0).toUpperCase() + limpio.slice(1)).replace(/\btv\b/gi, 'TV');
};
---

<section id="incluye" class="scroll-mt-20 border-y border-line bg-night/60 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-5 md:px-10">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-tight">Todos los planes incluyen</h2>
      <p class="mt-3 text-lg text-mist">Lo mismo que esperas de una plataforma de streaming, más TV en vivo y deportes.</p>
    </div>

    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {beneficios.map((item, i) => (
        <li class="flex gap-4">
          <span class="grid h-11 w-11 flex-none place-items-center rounded-xl bg-signal/15 text-[#7aa2ff]">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i] ?? icons[0]} />
          </span>
          <div>
            <h3 class="text-lg font-bold">
              {titulo(item.texto)}{esOpcional(item.texto) && <span class="ml-2 align-middle text-xs font-semibold text-mist">opcional</span>}
            </h3>
            <p class="mt-1.5 leading-relaxed text-mist">{item.info}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
