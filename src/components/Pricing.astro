---
// src/components/Pricing.astro
import contenido from '../data/contenido.json';
const { planes, site } = contenido;

const link = (_msg: string) => site.whatsappLink; // todos los botones van al canal de WhatsApp
const nombre = (n: string) => n.charAt(0) + n.slice(1).toLowerCase();
const logoRecortado = (src: string) => src.replace(/boox_(tv_)?(\w+?)_logo\.png$/, "plan-$2.png");
---

<section id="planes" class="scroll-mt-20 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-5 md:px-10">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-tight">Elige tu plan</h2>
      <p class="mt-3 text-lg text-mist">Pago mensual, sin contrato. Pruébalo gratis y paga solo si te convence.</p>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3 lg:items-stretch">
      {planes.map((plan) => (
        <article class={`relative flex flex-col rounded-2xl p-7 md:p-8 ${plan.destacado
          ? 'bg-gradient-to-b from-[#1c1650] to-deep ring-2 ring-boox shadow-[0_30px_80px_-30px_rgba(234,179,8,0.35)] lg:-my-4 lg:py-11'
          : 'bg-night ring-1 ring-line'}`}>
          {plan.destacado && (
            <span class="absolute -top-3.5 left-7 rounded-full bg-boox px-3 py-1 text-xs font-bold text-black">Recomendado</span>
          )}

          <div class="flex h-16 items-center">
            <img src={logoRecortado(plan.logo)} alt={`BooxTV ${nombre(plan.nombre)}`} class="max-h-full max-w-[170px] w-auto object-contain object-left" loading="lazy" />
          </div>
          <p class="mt-4 min-h-[3rem] text-mist leading-relaxed">{plan.ideal}</p>

          <div class="mt-6 flex items-baseline gap-1.5">
            <span class="text-5xl font-extrabold tracking-[-0.04em]">${plan.precio}</span>
            <span class="text-mist">MXN al mes</span>
          </div>

          <ul class="mt-7 space-y-3.5 border-t border-line pt-7 flex-grow">
            {plan.features.map(f => (
              <li class="flex gap-3">
                <svg class={`mt-0.5 h-5 w-5 flex-none ${f.highlight ? 'text-boox' : 'text-white/50'}`} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
                <span class={f.highlight ? 'text-white' : 'text-white/80'}>{f.text}</span>
              </li>
            ))}
            <li class="flex gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-none text-white/50" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              <span class="text-white/80">3 dispositivos al mismo tiempo</span>
            </li>
          </ul>

          <div class="mt-8 grid gap-2.5">
            <a href={link(`Hola, quisiera contratar un plan ${plan.nombre}`)} target="_blank" rel="noopener noreferrer"
              class={`rounded-xl py-3.5 text-center font-bold transition-colors ${plan.destacado ? 'bg-boox text-black hover:bg-yellow-400' : 'bg-white text-black hover:bg-white/85'}`}>
              Contratar {nombre(plan.nombre)}
            </a>
            <a href={link(`Hola, quisiera una prueba gratis del plan ${plan.nombre}`)} target="_blank" rel="noopener noreferrer"
              class="rounded-xl py-3.5 text-center font-semibold text-white ring-1 ring-white/20 hover:bg-white/5 transition-colors">
              Probar gratis
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-10 text-sm text-mist">Precios en pesos mexicanos. Pagas por transferencia bancaria o depósito en OXXO, y recibes tu acceso por WhatsApp.</p>
  </div>
</section>
