---
// src/components/MovieCarousel.astro — filas de contenido al estilo de una plataforma de streaming
import contenido from "../data/contenido.json";
const { movieSection } = contenido;

const name = (src: string) =>
  src.split("/").pop()!.replace(/\.(jpg|png|webp)$/i, "").replace(/[_]+/g, " ")
    .replace(/\b\w/g, (m) => m.toUpperCase());

const rows = [
  {
    id: "fila-peliculas",
    titulo: movieSection.categoria1,
    items: ["/movies/avatar.jpg", "/movies/dune.jpg", "/movies/spiderman.jpg", "/movies/john_wick.jpg",
      "/movies/mision_imposible.jpg", "/movies/f1.jpg", "/movies/creed.jpg", "/movies/Flow.jpg",
      "/movies/michael_jackson.jpg", "/movies/hoppers.jpg", "/movies/titanic.jpg", "/movies/laland.jpg"],
  },
  {
    id: "fila-series",
    titulo: movieSection.categoria2,
    items: ["/series/tlou.jpg", "/series/stranger things.jpg", "/series/the mandalorian.jpg", "/series/thebear.jpg",
      "/series/better call saul.jpg", "/series/greys_anatomy.jpg", "/series/the last dance.jpg",
      "/series/our planet.jpg", "/series/the eras tour.jpg"],
  },
  {
    id: "fila-generos",
    titulo: movieSection.categoria3,
    items: ["/movies/back_to_future.jpg", "/movies/Your_Name.jpg", "/movies/demon_slayer.jpg", "/movies/mulan.jpg",
      "/movies/cars.jpg", "/movies/rocky_balboa.jpg", "/movies/cruella.jpg", "/movies/anabelle.jpg",
      "/movies/scream.jpg", "/movies/IT.jpg", "/movies/querido_john.jpg", "/movies/yo_antes_de_ti.jpg",
      "/movies/esposa_mentiras.jpg"],
  },
];
---

<section id="contenido" class="scroll-mt-20 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-5 md:px-10">
    <h2 class="text-3xl md:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-tight">{movieSection.titulo}</h2>
    <p class="mt-3 max-w-xl text-lg text-mist">Estrenos de cine, series completas y títulos para toda la familia, con actualizaciones constantes.</p>
  </div>

  <div class="mt-10 space-y-10 md:space-y-12">
    {rows.map((row) => (
      <div class="rail" data-rail={row.id}>
        <div class="mx-auto flex max-w-7xl items-end justify-between px-5 md:px-10">
          <h3 class="text-lg md:text-xl font-bold">{row.titulo}</h3>
          <div class="hidden md:flex gap-2">
            <button class="rail-btn" data-dir="-1" aria-label={`Anterior en ${row.titulo}`}>
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="rail-btn" data-dir="1" aria-label={`Siguiente en ${row.titulo}`}>
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
        <ul class="rail-track no-scrollbar mt-4 flex gap-3 md:gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth">
          {row.items.map((src) => (
            <li class="snap-start flex-none w-[38vw] sm:w-[28vw] md:w-[200px] lg:w-[215px]">
              <img src={src} alt={name(src)} loading="lazy" decoding="async"
                class="aspect-[2/3] w-full rounded-lg object-cover ring-1 ring-white/10 transition-transform duration-300 hover:scale-[1.03]" />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  const initRails = () => {
    document.querySelectorAll<HTMLElement>('.rail').forEach((rail) => {
      const track = rail.querySelector<HTMLElement>('.rail-track');
      rail.querySelectorAll<HTMLButtonElement>('.rail-btn').forEach((btn) => {
        btn.onclick = () => {
          if (!track) return;
          track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth * 0.85, behavior: 'smooth' });
        };
      });
    });
  };
  document.addEventListener('DOMContentLoaded', initRails);
  document.addEventListener('astro:page-load', initRails);
</script>

<style>
  .rail-track {
    /* alinea el primer póster con el contenido y deja ver que hay más a la derecha */
    padding-inline: max(1.25rem, calc((100vw - 80rem) / 2 + 2.5rem));
    scroll-padding-inline: max(1.25rem, calc((100vw - 80rem) / 2 + 2.5rem));
  }
  @media (max-width: 767px) {
    .rail-track { padding-inline: 1.25rem; scroll-padding-inline: 1.25rem; }
  }
  .rail-btn {
    display: grid;
    place-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: rgb(255 255 255 / 0.04);
    color: white;
    transition: background-color .2s;
  }
  .rail-btn:hover { background: rgb(255 255 255 / 0.12); }
</style>
